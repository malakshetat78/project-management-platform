# Configure BOOTSTRAP_TOKEN as a secret in your hosting environment.
# Generate a random 32-byte token. Never commit a real value.
BOOTSTRAP_TOKEN=replace-with-a-random-64-character-hex-token
# Local development: put the same value in ignored .dev.vars.
# Cloudflare D1: DB. Cloudflare R2: BUCKET.
# Actual production bindings are managed by Sites; .openai/hosting.json has logical names only.

# Email of the ChatGPT account that owns first-time activation.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
